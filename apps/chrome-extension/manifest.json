{
  "manifest_version": 3,
  "name": "Tabs Anonymous: Last Tab Standing",
  "version": "0.5.0",
  "description": "An animated support group for your tabs. Local metadata, optional approved grouping, zero tab closing.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Start tab therapy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "optional_permissions": ["tabs", "tabGroups"],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": ["http://127.0.0.1/*"]
}
